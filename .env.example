# Alpha-Seekers Frontend Environment Variables
# Copy this file to .env.local and fill in the values
# cp .env.example .env.local

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL (use local for development, production URL for deployment)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/

# =============================================================================
# Firebase Configuration (Client-side)
# Get these from Firebase Console > Project Settings > General > Your apps
# =============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# Optional: Email Configuration (for contact forms, notifications)
# =============================================================================

# NODE_EMAIL=your_email@example.com
# NODE_EMAIL_PASS=your_app_password
